# Vercel / GitHub Pages frontend build: the persistent game server's public WSS endpoint.
# Leave unset for same-origin hosting with npm start or npm run dev:online.
VITE_MULTIPLAYER_URL=wss://your-game-server.example/online

# Game server only (never put secrets in VITE_* variables).
PORT=3001
ALLOWED_ORIGINS=https://your-game.vercel.app,https://ceenguyen05.github.io
# Raise when your hosting proxy presents all players under one network peer IP;
# apply real client-IP limits at the trusted ingress in that case.
MAX_CONNECTIONS_PER_IP=16
# Free Render deployment: set ACCOUNT_STORAGE=mysql and all MYSQL_* in Render.
# These credentials belong only on the backend. Never prefix them with VITE_.
# Local development defaults to file storage. npm start reads process environment;
# copy values into your host's Environment settings (it does not load this file).
ACCOUNT_STORAGE=file
DATA_DIR=./server-data
# MYSQL_HOST=your-service.aivencloud.com
# MYSQL_PORT=your-port-from-aiven
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your-database-password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
