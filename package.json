{
  "name": "aci-snd",
  "version": "1.7.6",
  "private": true,
  "description": "ACI: Search & Destroy - a CS-style tactical shooter on two office maps (ACI HQ and ACI Building 2), built with Three.js",
  "homepage": "https://ceenguyen05.github.io/ACI-SND/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceenguyen05/ACI-SND.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && vite build",
    "check:boot": "node scripts/checks/boot-check.mjs --no-build",
    "smoke": "node scripts/checks/smoke-test.mjs",
    "screenshots": "node scripts/visual/screenshots.mjs",
    "balance": "node scripts/tools/balance.mjs",
    "map:ascii": "node scripts/tools/print-map.mjs",
    "verify": "npm run check && npm run check:boot && node scripts/checks/smoke-test.mjs --no-build && node scripts/checks/keys-check.mjs --no-build && node scripts/checks/maps-check.mjs --no-build && node scripts/checks/zombies-check.mjs --no-build && node --import tsx scripts/checks/online-check.mjs --no-build",
    "test:maps": "node scripts/checks/maps-check.mjs",
    "perf": "node scripts/perf/perf.mjs",
    "test:handling": "node scripts/checks/handling-check.mjs",
    "test:keys": "node scripts/checks/keys-check.mjs",
    "test:visual": "node scripts/checks/visual-check.mjs",
    "assets:surfaces": "node scripts/tools/fetch-surface-assets.mjs",
    "bake": "node scripts/tools/bake-lighting.mjs",
    "test:zombies": "node scripts/checks/zombies-check.mjs",
    "test:gunplay": "node scripts/checks/gunplay-check.mjs",
    "diag": "node scripts/tools/diag.mjs",
    "start": "tsx server/index.ts",
    "dev:online": "node scripts/tools/online-dev.mjs",
    "test:online": "vitest run tests/online",
    "test:online:browser": "node --import tsx scripts/checks/online-check.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
