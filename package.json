{
  "name": "aci-snd",
  "version": "0.1.0",
  "private": true,
  "description": "ACI: Search & Destroy - a CS-style tactical shooter on a single office/factory map, built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "balance": "node scripts/balance.mjs",
    "map:ascii": "node scripts/print-map.mjs",
    "verify": "npm run typecheck && npm test && npm run smoke",
    "perf": "node scripts/perf.mjs",
    "test:handling": "node scripts/handling-check.mjs",
    "test:keys": "node scripts/keys-check.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "assets:surfaces": "node scripts/fetch-surface-assets.mjs",
    "bake": "node scripts/bake-lighting.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
